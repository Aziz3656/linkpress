{
  "name": "linkpress",
  "productName": "LinkPress",
  "version": "0.1.1",
  "description": "Universal link-to-video downloader and offline batch compressor",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-bin": "node scripts/fetch-bin.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.linkpress.desktop",
    "productName": "LinkPress",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LinkPress-Setup-${version}.${ext}"
    },
    "artifactName": "LinkPress-${version}-${arch}-${name}.${ext}",
    "portable": {
      "artifactName": "LinkPress-Portable-${version}.${ext}"
    }
  }
}